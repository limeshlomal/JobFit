PORT=5000
NODE_ENV=development

DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cv_job_app

JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=15m

# Live job search (JSearch via RapidAPI) — sign up free at
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch and subscribe to
# the free plan to get a key. Without this set, the app falls back to a
# small curated set of mock jobs and keeps working.
RAPIDAPI_KEY=
RAPIDAPI_HOST=jsearch.p.rapidapi.com

# CV tailoring + cover letter generation (Claude API) — get a key at
# https://console.anthropic.com/settings/keys. Each generation costs real
# money (pay-per-token). Without this set, tailoring requests will fail.
ANTHROPIC_API_KEY=
